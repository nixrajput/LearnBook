{
  "name": "learnbook",
  "version": "0.2.4",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "npm run dev --workspace=app",
    "build": "npm run build --workspace=app",
    "test": "npm run test --workspace=app",
    "lint": "npm run lint --workspace=app",
    "lint:fix": "npm run lint:fix --workspace=app",
    "format": "npm run format --workspace=app",
    "format:check": "npm run format:check --workspace=app",
    "db:generate": "npm run db:generate --workspace=app",
    "db:push": "npm run db:push --workspace=app",
    "db:seed": "npm run db:seed --workspace=app",
    "db:reset": "npm run db:reset --workspace=app",
    "db:studio": "npm run db:studio --workspace=app"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.2"
  },
  "overrides": {
    "next": "16.4.6",
    "effect": "3.22.1",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  },
  "lint-staged": {
    "app/src/**/*.{ts,tsx}": [
      "eslint --config app/eslint.config.mjs --fix",
      "prettier --write"
    ],
    "app/src/**/*.css": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "26.x"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
