# Monorepo root gitignore

# Node
node_modules/
.npm
# Workspace lockfiles (only root package-lock.json should exist)
app/package-lock.json

# App build artifacts
app/node_modules/
app/.next/
app/out/
app/build/
app/dist/

# Prisma / SQLite databases (each app manages its own)
app/*.db
app/*.db-journal
app/*.db-shm
app/*.db-wal
app/prisma/migrations/

# Next.js
app/next-env.d.ts
app/*.tsbuildinfo

# Env files — keep .env.example, ignore actual secrets
app/.env
app/.env.local
app/.env*.local

# OS
.DS_Store
*.pem

# Coverage
coverage/
app/coverage/

.playwright-mcp/
plans/

# Course content files (local upload directory, managed in Phase 7)
courses/
